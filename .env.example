# Puerto donde corre el servidor Express
PORT=8080

# Entorno de ejecución (development | production)
NODE_ENV=development

# Cadena de conexión a MongoDB (MongoDB Atlas o local)
# Ejemplo MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/trionix_tickets?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/trionix_db?retryWrites=true&w=majority
